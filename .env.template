# Copy this file to `.env` and fill it in. Never commit `.env`.

# --- Required ---
# Bot token from https://discord.com/developers/applications (Bot → Reset Token)
DISCORD_TOKEN=""
# Path to cdclient.sqlite (convert the client's cdclient.fdb at https://fdb.lu-dev.net/)
CDCLIENT_PATH="~/cdclient.sqlite"
# Path to the client's locale.xml (PATH_TO_LU_CLIENT/locale/locale.xml)
LOCALE_PATH="~/locale.xml"

# --- Optional ---
# Register commands to one server only (they update instantly); leave blank to register globally
GUILD_ID=""
# Which locale to read from locale.xml
LOCALE="en_US"
# LU Explorer instance used for links and icons
EXPLORER_URL="https://explorer.lu/"
# Where icons are hosted (defaults to EXPLORER_URL + lu-res/)
EXPLORER_RES_URL=""
# Embed color
BOT_COLOR="#1a87e8"
# Embed header and footer
AUTHOR_NAME="Crab Force"
AUTHOR_ICON=""
AUTHOR_URL="https://github.com/MasterTemple/Crab-Force"
FOOTER_TEXT="LEGO® is a trademark of the LEGO Group which does not sponsor, authorize, or endorse this bot. The data and assets are presented purely for informational purposes."
FOOTER_ICON=""
# Only show objects with HQ_valid = 1 (hides unreleased/test content)
HQ_VALID_ONLY=false
# Decimal places for drop chances
DECIMAL_PLACES=4
# Role ids allowed to use /reload (comma separated); if blank, only Administrators can
ADMIN_ROLE_IDS=""

# Log level (error, warn, info, debug, trace)
RUST_LOG="info,serenity=warn"
